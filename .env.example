DJANGO_API_URL=http://127.0.0.1:8000
ADMIN_SERVICE_KEY=change-me
# Non-pooled connection is required for `prisma migrate deploy`; DATABASE_URL
# may point at a pooler (e.g. PgBouncer/Accelerate) — DIRECT_URL must not.
DATABASE_URL=postgres://postgres:1122@localhost:5432/landing
DIRECT_URL=postgres://postgres:1122@localhost:5432/landing
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@prepiq.net

# next-auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# Support pipeline
SUPPORT_API_KEY=change-me
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PrepIQ Concierge (landing-page chatbot) — must match backend CONCIERGE_SERVICE_KEY
CONCIERGE_SERVICE_KEY=change-me
CONCIERGE_IP_SALT=change-me
