generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}


enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
  ACTIVATE
  DEACTIVATE
  LOGIN
  LOGOUT
}

enum EntityType {
  PAGE
  SECTION
  LINK
  USER
  MESSAGE
  MEETING
  LEGAL_DOC
  SUPPORT_REQUEST
  JOB_ROLE
  JOB_APPLICATION
  BLOG_POST
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  role          Role          @default(EDITOR)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  activities    ActivityLog[]
}

model ActivityLog {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    ActionType
  entity    EntityType
  entityId  String?
  details   String?
  createdAt DateTime   @default(now())
}


model Page {
  id                 String    @id @default(cuid())
  slug               String    @unique
  titleEn            String
  titleFr            String
  isActive           Boolean   @default(true)
  sortOrder          Int       @default(0)
  metaDescriptionEn  String?
  metaDescriptionFr  String?
  configJson         Json?     @default("{}") // Global page configuration
  sections           Section[]

  @@index([isActive])
  @@index([slug, isActive])
}

model Section {
  id            String  @id @default(cuid())
  pageId        String
  page          Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  componentType String
  titleEn       String?
  titleFr       String?
  contentJson   Json
  styleJson     Json?   @default("{}") // Component-specific styling
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  @@index([pageId, isActive, sortOrder])
}

model LegalDocument {
  id            String                 @id @default(cuid())
  slug          String                 @unique // "privacy-policy" | "terms-of-service" | "security"
  titleEn       String
  titleFr       String
  bodyEn        String // markdown
  bodyFr        String // markdown
  version       Int                    @default(1)
  effectiveDate DateTime               @default(now())
  isPublished   Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  versions      LegalDocumentVersion[]

  @@index([slug, isPublished])
}

// Immutable snapshot written on every publish — compliance/audit trail.
model LegalDocumentVersion {
  id            String        @id @default(cuid())
  documentId    String
  document      LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version       Int
  titleEn       String
  titleFr       String
  bodyEn        String
  bodyFr        String
  effectiveDate DateTime
  publishedAt   DateTime      @default(now())
  publishedBy   String? // admin email

  @@unique([documentId, version])
}

model Link {
  id        String  @id @default(cuid())
  labelEn   String
  labelFr   String
  url       String
  type      String  // 'nav' or 'footer'
  category  String? // for grouping footer links
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  status    String   @default("unread") // "unread", "read", "archived"
}

enum SupportRequestType {
  BUG
  FEATURE_REQUEST
  INQUIRY
  FEEDBACK
}

enum SupportRequestStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportRequest {
  id    String @id @default(cuid())
  refNo Int    @unique @default(autoincrement()) // displayed as "PIQ-{refNo}"

  type     SupportRequestType
  status   SupportRequestStatus @default(NEW)
  priority SupportPriority      @default(MEDIUM)

  subject String
  message String

  // Where the reporter wants the reply. Null = they opted out of a reply;
  // full reporter context below is still captured either way.
  contactEmail String?

  // Reporter identity, verified server-side by the submitting app.
  reporterEmail    String
  reporterName     String?
  reporterUserId   String?
  reporterRole     String?
  organizationId   String?
  organizationName String?
  branchId         String?
  branchName       String?

  // Environment context, auto-captured (mostly useful for bugs).
  sourceApp  String  @default("web_dashboard")
  appVersion String?
  currentUrl String?
  userAgent  String?
  locale     String?

  adminNotes String?

  // Feature requests only: whether this appears on the in-app voting board.
  isPublic Boolean @default(false)

  attachments SupportAttachment[]
  votes       SupportVote[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([type, status])
  @@index([createdAt])
}

model SupportAttachment {
  id        String         @id @default(cuid())
  requestId String
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // Cloudinary identifiers — publicId + resourceType are required to destroy
  // the cloud asset when an admin deletes the attachment or its request.
  publicId     String @unique
  resourceType String @default("image") // "image" | "raw" | "video"
  url          String
  filename     String
  format       String?
  bytes        Int     @default(0)

  createdAt DateTime @default(now())
}

model SupportVote {
  id        String         @id @default(cuid())
  requestId String
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  voterEmail String
  voterName  String?
  createdAt  DateTime @default(now())

  @@unique([requestId, voterEmail])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  NEW
  REVIEWING
  INTERVIEWING
  OFFER
  HIRED
  REJECTED
}

model JobRole {
  id             String         @id @default(cuid())
  slug           String         @unique
  titleEn        String
  titleFr        String
  department     String // e.g. "Engineering", "Design", "Sales"
  location       String // e.g. "Remote", "Kampala, Uganda"
  employmentType EmploymentType @default(FULL_TIME)
  // Short one-line summary shown on cards / listings.
  summaryEn      String
  summaryFr      String
  // Full role description — Markdown, rendered on the detail page.
  bodyEn         String
  bodyFr         String
  isPublished    Boolean        @default(false)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  applications   JobApplication[]

  @@index([isPublished, sortOrder])
}

model JobApplication {
  id          String            @id @default(cuid())
  refNo       Int               @unique @default(autoincrement()) // displayed as "APP-{refNo}"
  roleId      String
  role        JobRole           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  name        String
  email       String
  // Resume/portfolio are captured as links — no file uploads by design.
  resumeUrl   String
  linkedinUrl String?
  coverNote   String?

  status      ApplicationStatus @default(NEW)
  adminNotes  String?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([roleId, status])
  @@index([createdAt])
}

model BlogPost {
  id   String @id @default(cuid())
  slug String @unique

  // Unlike JobRole/LegalDocument, the French variants are optional: a 1,500-word
  // article is too costly to mirror on every publish, so the public pages fall
  // back to English whenever a French field is empty.
  titleEn   String
  titleFr   String?
  excerptEn String
  excerptFr String?
  bodyEn    String // markdown
  bodyFr    String? // markdown

  // Cover/thumbnail. publicId is retained so the asset can be destroyed when the
  // cover is replaced or the post is deleted.
  coverUrl      String?
  coverPublicId String?
  coverAlt      String?

  category String   @default("Operations")
  tags     String[] @default([])

  authorName   String  @default("PrepIQ Team")
  authorRole   String?
  authorAvatar String?

  // Overrides the computed word-count estimate when set.
  readMinutes Int?

  // SEO overrides — fall back to title/excerpt when null.
  seoTitle       String?
  seoDescription String?

  isPublished Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  // Ordering for the featured strip on the home page; lower shows first.
  sortOrder   Int       @default(0)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images BlogImage[]

  @@index([isPublished, publishedAt])
  @@index([isPublished, isFeatured, sortOrder])
  @@index([category])
}

// Every Cloudinary asset uploaded through the blog editor, so in-body images can
// be destroyed alongside their post instead of leaking in the media account.
model BlogImage {
  id     String    @id @default(cuid())
  postId String?
  post   BlogPost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  publicId String @unique
  url      String
  filename String
  format   String?
  width    Int     @default(0)
  height   Int     @default(0)
  bytes    Int     @default(0)

  createdAt DateTime @default(now())

  @@index([postId])
}

enum MeetingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Meeting {
  id          String        @id @default(cuid())
  name        String
  email       String
  company     String?
  phone       String?
  date        DateTime
  notes       String?
  meetingLink String?
  status      MeetingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
