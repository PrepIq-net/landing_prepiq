generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App runtime uses the pooled (PgBouncer) connection. Migrations and
  // introspection use a DIRECT, unpooled connection: Prisma Migrate takes a
  // session-level advisory lock, which times out (P1002) through Neon's
  // transaction-mode pooler. DIRECT_URL must point at the non-"-pooler" host.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
  ACTIVATE
  DEACTIVATE
  LOGIN
  LOGOUT
}

enum EntityType {
  PAGE
  SECTION
  LINK
  USER
  MESSAGE
  MEETING
  LEGAL_DOC
  SUPPORT_REQUEST
  JOB_ROLE
  JOB_APPLICATION
  BLOG_POST
  CONCIERGE_CONVERSATION
  CONCIERGE_LEAD
  TESTIMONIAL
  KITCHEN_CALCULATOR_LEAD
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(EDITOR)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activities   ActivityLog[]
}

model ActivityLog {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    ActionType
  entity    EntityType
  entityId  String?
  details   String?
  createdAt DateTime   @default(now())
}

model Page {
  id                String    @id @default(cuid())
  slug              String    @unique
  titleEn           String
  titleFr           String
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)
  metaDescriptionEn String?
  metaDescriptionFr String?
  configJson        Json?     @default("{}") // Global page configuration
  sections          Section[]

  @@index([isActive])
  @@index([slug, isActive])
}

model Section {
  id            String  @id @default(cuid())
  pageId        String
  page          Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  componentType String
  titleEn       String?
  titleFr       String?
  contentJson   Json
  styleJson     Json?   @default("{}") // Component-specific styling
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  @@index([pageId, isActive, sortOrder])
}

model LegalDocument {
  id            String                 @id @default(cuid())
  slug          String                 @unique // "privacy-policy" | "terms-of-service" | "security"
  titleEn       String
  titleFr       String
  bodyEn        String // markdown
  bodyFr        String // markdown
  version       Int                    @default(1)
  effectiveDate DateTime               @default(now())
  isPublished   Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  versions      LegalDocumentVersion[]

  @@index([slug, isPublished])
}

// Immutable snapshot written on every publish — compliance/audit trail.
model LegalDocumentVersion {
  id            String        @id @default(cuid())
  documentId    String
  document      LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version       Int
  titleEn       String
  titleFr       String
  bodyEn        String
  bodyFr        String
  effectiveDate DateTime
  publishedAt   DateTime      @default(now())
  publishedBy   String? // admin email

  @@unique([documentId, version])
}

model Link {
  id        String  @id @default(cuid())
  labelEn   String
  labelFr   String
  url       String
  type      String // 'nav' or 'footer'
  category  String? // for grouping footer links
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

/// Customer testimonials shown on the marketing site.
///
/// This table is the *only* source of testimonials — the landing page renders
/// nothing rather than falling back to authored placeholder quotes, so an empty
/// table means an empty (honest) section. Add rows here as real customers give
/// us permission to quote them.
model Testimonial {
  id      String  @id @default(cuid())
  quoteEn String
  /// Optional: an untranslated quote is shown as-is to French visitors rather
  /// than being dropped, since a real quote in the wrong language still beats
  /// no quote at all.
  quoteFr String?

  name    String
  role    String
  company String

  /// Headline figure shown above the quote (e.g. "12% less waste"). Optional by
  /// design: only fill it in when the customer stated the number themselves.
  metricEn String?
  metricFr String?

  /// Set once we have written permission to publish the quote.
  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  status    String   @default("unread") // "unread", "read", "archived"
}

enum SupportRequestType {
  BUG
  FEATURE_REQUEST
  INQUIRY
  FEEDBACK
}

enum SupportRequestStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportRequest {
  id    String @id @default(cuid())
  refNo Int    @unique @default(autoincrement()) // displayed as "PIQ-{refNo}"

  type     SupportRequestType
  status   SupportRequestStatus @default(NEW)
  priority SupportPriority      @default(MEDIUM)

  subject String
  message String

  // Where the reporter wants the reply. Null = they opted out of a reply;
  // full reporter context below is still captured either way.
  contactEmail String?

  // Reporter identity, verified server-side by the submitting app.
  reporterEmail    String
  reporterName     String?
  reporterUserId   String?
  reporterRole     String?
  organizationId   String?
  organizationName String?
  branchId         String?
  branchName       String?

  // Environment context, auto-captured (mostly useful for bugs).
  sourceApp  String  @default("web_dashboard")
  appVersion String?
  currentUrl String?
  userAgent  String?
  locale     String?

  adminNotes String?

  // Feature requests only: whether this appears on the in-app voting board.
  isPublic Boolean @default(false)

  attachments SupportAttachment[]
  votes       SupportVote[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([type, status])
  @@index([createdAt])
}

model SupportAttachment {
  id        String         @id @default(cuid())
  requestId String
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // Cloudinary identifiers — publicId + resourceType are required to destroy
  // the cloud asset when an admin deletes the attachment or its request.
  publicId     String  @unique
  resourceType String  @default("image") // "image" | "raw" | "video"
  url          String
  filename     String
  format       String?
  bytes        Int     @default(0)

  createdAt DateTime @default(now())
}

model SupportVote {
  id        String         @id @default(cuid())
  requestId String
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  voterEmail String
  voterName  String?
  createdAt  DateTime @default(now())

  @@unique([requestId, voterEmail])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  NEW
  REVIEWING
  INTERVIEWING
  OFFER
  HIRED
  REJECTED
}

model JobRole {
  id             String           @id @default(cuid())
  slug           String           @unique
  titleEn        String
  titleFr        String
  department     String // e.g. "Engineering", "Design", "Sales"
  location       String // e.g. "Remote", "Kampala, Uganda"
  employmentType EmploymentType   @default(FULL_TIME)
  // Short one-line summary shown on cards / listings.
  summaryEn      String
  summaryFr      String
  // Full role description — Markdown, rendered on the detail page.
  bodyEn         String
  bodyFr         String
  isPublished    Boolean          @default(false)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applications   JobApplication[]

  @@index([isPublished, sortOrder])
}

model JobApplication {
  id     String  @id @default(cuid())
  refNo  Int     @unique @default(autoincrement()) // displayed as "APP-{refNo}"
  roleId String
  role   JobRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  name        String
  email       String
  // Resume/portfolio are captured as links — no file uploads by design.
  resumeUrl   String
  linkedinUrl String?
  coverNote   String?

  status     ApplicationStatus @default(NEW)
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId, status])
  @@index([createdAt])
}

model BlogPost {
  id   String @id @default(cuid())
  slug String @unique

  // Unlike JobRole/LegalDocument, the French variants are optional: a 1,500-word
  // article is too costly to mirror on every publish, so the public pages fall
  // back to English whenever a French field is empty.
  titleEn   String
  titleFr   String?
  excerptEn String
  excerptFr String?
  bodyEn    String // markdown
  bodyFr    String? // markdown

  // Cover/thumbnail. publicId is retained so the asset can be destroyed when the
  // cover is replaced or the post is deleted.
  coverUrl      String?
  coverPublicId String?
  coverAlt      String?

  // Pre-generated neural narration (Microsoft Edge TTS → Cloudinary). Optional
  // per language and generated on demand from the admin editor, not on every
  // publish — a long article is minutes of audio and too slow to synthesise
  // inline. publicId is kept so the asset can be destroyed on replace/delete.
  audioUrlEn      String?
  audioPublicIdEn String?
  audioUrlFr      String?
  audioPublicIdFr String?
  audioUpdatedAt  DateTime?

  category String   @default("Operations")
  tags     String[] @default([])

  authorName   String  @default("PrepIQ Team")
  authorRole   String?
  authorAvatar String?

  // Overrides the computed word-count estimate when set.
  readMinutes Int?

  // SEO overrides — fall back to title/excerpt when null.
  seoTitle       String?
  seoDescription String?

  isPublished Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  // Ordering for the featured strip on the home page; lower shows first.
  sortOrder   Int       @default(0)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images BlogImage[]

  @@index([isPublished, publishedAt])
  @@index([isPublished, isFeatured, sortOrder])
  @@index([category])
}

// Every Cloudinary asset uploaded through the blog editor, so in-body images can
// be destroyed alongside their post instead of leaking in the media account.
model BlogImage {
  id     String    @id @default(cuid())
  postId String?
  post   BlogPost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  publicId String  @unique
  url      String
  filename String
  format   String?
  width    Int     @default(0)
  height   Int     @default(0)
  bytes    Int     @default(0)

  createdAt DateTime @default(now())

  @@index([postId])
}

enum MeetingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Meeting {
  id          String        @id @default(cuid())
  name        String
  email       String
  company     String?
  phone       String?
  date        DateTime
  notes       String?
  meetingLink String?
  status      MeetingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ---------------------------------------------------------------------------
// PrepIQ Concierge — landing-page sales chatbot
// ---------------------------------------------------------------------------

enum ConciergeMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model ConciergeConversation {
  id    String @id @default(cuid())
  refNo Int    @unique @default(autoincrement()) // displayed as "CHAT-{refNo}"

  locale    String @default("en")
  visitorId String // anonymous id minted by the widget (localStorage)

  // Abuse tracing without storing raw IPs: sha256(ip + CONCIERGE_IP_SALT).
  ipHash      String?
  userAgent   String?
  startedPath String? // page the chat was opened on

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  endedAt   DateTime?

  messageCount Int @default(0) // denormalized for the admin list

  // Future phases attach here without migrations: topic tags, objection
  // counts, ROI-calculator inputs, qualification score.
  meta Json?

  messages ConciergeMessage[]
  lead     ConciergeLead?

  @@index([updatedAt])
  @@index([visitorId])
}

model ConciergeMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   ConciergeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role      ConciergeMessageRole
  content   String
  createdAt DateTime             @default(now())

  // Assistant turns: { provider, model, usage, latencyMs }. Future analytics
  // (topicTag, objectionType, intent) attach here without migrations.
  meta Json?

  @@index([conversationId, createdAt])
}

model ConciergeLead {
  id             String                @id @default(cuid())
  conversationId String                @unique
  conversation   ConciergeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  email          String
  restaurantName String?
  location       String?
  role           String?
  phone          String?

  createdAt DateTime @default(now())

  // Future: qualification score, plan interest, handled-by markers.
  meta Json?
}

// Kitchen Intelligence Calculator (landing-page lead-gen tool, /kitchen-intelligence-calculator).
// Inputs are the visitor's own answers; the "Deterministic engine output" block
// is always recomputed server-side from those answers (never trusted from the
// client) via src/lib/kitchen-calculator/engine.ts. `explanation` is a
// best-effort LLM narrative over that output — null if the provider chain was
// unavailable, since a failed narrative must never block lead capture.
model KitchenCalculatorLead {
  id    String @id @default(cuid())
  refNo Int    @unique @default(autoincrement()) // displayed as "KIC-{refNo}"

  locale    String  @default("en")
  visitorId String?

  // Step 1 — operation
  weeklyRevenuePerLocation Float
  currency                 String // "USD" | "EUR" | "UGX" | "KES" | "RWF" | "OTHER"
  locations                Int

  // Step 2 — kitchen
  operatingDays  Int
  planningMethod String // "intuition" | "spreadsheet" | "pos_reports" | "forecasting"

  // Step 3 — optional refinement (visitor may skip)
  wasteEstimate     String? // "lt2" | "2to5" | "5to10" | "gt10" | "unknown"
  stockoutFrequency String? // "rarely" | "sometimes" | "frequently" | "unknown"

  // Step 4 — lead
  email          String
  restaurantName String?

  // Deterministic engine output
  weeklyNetworkRevenue       Float
  annualRevenue              Float
  wasteExposureLow           Float
  wasteExposureHigh          Float
  stockoutExposureLow        Float
  stockoutExposureHigh       Float
  annualImpactLow            Float
  annualImpactHigh           Float
  forecastUncertaintyLow     Float
  forecastUncertaintyHigh    Float
  intelligenceScore          Int
  planningMaturityScore      Int
  forecastingMaturityScore   Int
  // Null when the visitor skipped the optional step-3 refinement.
  wasteVisibilityScore       Int?
  operationalVisibilityScore Int?
  primaryOpportunity         String
  // Copy-selection key for the snapshot email — persisted so an admin resend
  // reproduces the exact email the visitor originally received, even if the
  // engine's key-selection logic changes later.
  primaryOpportunityKey      String

  // LLM narrative (best-effort)
  explanation     String?
  explanationMeta Json?

  ipHash    String?
  userAgent String?

  // Post-submission "Kitchen Intelligence Snapshot" follow-up email — sent
  // best-effort right after the lead is created. Null until a send has
  // succeeded; emailError holds the last failure reason so admin can retry.
  emailSentAt DateTime?
  emailError  String?

  handled   Boolean   @default(false)
  handledBy String?
  handledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meta Json? // headroom for future fields without a migration

  @@index([createdAt])
  @@index([email])
}
